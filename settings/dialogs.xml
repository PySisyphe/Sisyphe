<?xml version="1.0" ?><settings version="1.0">
	<Region>
		<Origin varmax="1024" varmin="0" vartype="lint">0|0|0</Origin>
		<Size varmax="1024" varmin="0" vartype="lint">0|0|0</Size>
	</Region>
	<TrajectoryLength>
		<ExtendEntry step="1.0" varmax="256.0" varmin="-256.0" vartype="float">0.0</ExtendEntry>
		<ExtendTarget step="1.0" varmax="256.0" varmin="-256.0" vartype="float">0.0</ExtendTarget>
		<ExtendEntryToMesh label="Project entry onto mesh surface" vartype="lstr">No</ExtendEntryToMesh>
		<ExtendTargetToMesh label="Project target onto mesh surface" vartype="lstr">No</ExtendTargetToMesh>
	</TrajectoryLength>
	<DuplicateTool>
		<Laterality step="1.0" varmax="256.0" varmin="-256.0" vartype="float">0.0</Laterality>
		<Antero-posterior step="1.0" varmax="256.0" varmin="-256.0" vartype="float">0.0</Antero-posterior>
		<Height step="1.0" varmax="256.0" varmin="-256.0" vartype="float">0.0</Height>
		<Orientation vartype="lstr">Native|ACPC|Camera</Orientation>
		<Projection label="Point projection" vartype="lstr">No</Projection>
	</DuplicateTool>
	<FlipAxes>
		<Volumes vartype="vols"/>
		<FlipX label="Flip left/right axis" vartype="bool">False</FlipX>
		<FlipY label="Flip antero-posterior axis" vartype="bool">False</FlipY>
		<FlipZ label="Flip cranio-caudal axis" vartype="bool">False</FlipZ>
		<Prefix vartype="str">flip</Prefix>
	</FlipAxes>
	<SwapAxes>
		<Volumes vartype="vols"/>
		<SwapOrder vartype="lstr">y,z,x|z,x,y|x,z,y|y,z,x|z,y,x</SwapOrder>
		<Prefix vartype="str">swap</Prefix>
	</SwapAxes>
	<ChartProperties>
		<TitleVisibility vartype="bool">False</TitleVisibility>
		<FrameVisibility vartype="bool">False</FrameVisibility>
		<FrameColor label="Frame background color" vartype="color">1.0 1.0 1.0</FrameColor>
		<AxisVisibility vartype="bool">False</AxisVisibility>
		<Grid vartype="lstr">No|X|Y|Both</Grid>
		<GridDash vartype="lstr">Solid|Dashed|Dash-dotted|Dotted</GridDash>
		<GridOpacity vartype="percent">1.0</GridOpacity>
		<Legend vartype="lstr">No|Best|Upper right|Upper left|Lower right|Lower left|Lower center|Upper center|Center</Legend>
		<FigColor label="Figure background color" vartype="color">1.0 1.0 1.0</FigColor>
	</ChartProperties>
	<TractColor>
		<ColorMode vartype="lstr">RGB Direction|Solid|Scalars</ColorMode>
		<SolidColor vartype="color">1.0 1.0 1.0</SolidColor>
		<ScalarsVolume label="Scalars values volume" vartype="vol"/>
		<ScalarsLut vartype="lut">hot</ScalarsLut>
	</TractColor>
	<StatisticalModel>
		<Norm label="Signal normalization" vartype="lstr">No</Norm>
		<Ancova label="ANCOVA normalization" vartype="lstr">No</Ancova>
		<Roi1 label="ROI signal normalization" vartype="roi"/>
		<Mask label="Mask" vartype="lstr">Auto|Auto and ROI</Mask>
		<Roi2 label="Mask ROI" vartype="roi"/>
		<Age label="Age covariate" vartype="lstr">No</Age>
	</StatisticalModel>
	<Attributes>
		<Anonymize vartype="bool">False</Anonymize>
		<SetModality label="Set modality" vartype="bool">False</SetModality>
		<Modality vartype="lstr">dummy</Modality>
		<SetSequence label="Set sequence" vartype="bool">False</SetSequence>
		<OT vartype="lstr">dummy</OT>
		<MR vartype="lstr">dummy</MR>
		<CT vartype="lstr">dummy</CT>
		<NM vartype="lstr">dummy</NM>
		<PT vartype="lstr">dummy</PT>
		<LB vartype="lstr">LABELS</LB>
		<TP vartype="lstr">dummy</TP>
		<SetUnit label="Set unit" vartype="bool">False</SetUnit>
		<Unit vartype="lstr">dummy</Unit>
		<SetFrame label="Set frame" vartype="bool">False</SetFrame>
		<Frame vartype="lstr">dummy</Frame>
		<SetOrigin label="Set origin to default" vartype="bool">False</SetOrigin>
		<SetDirections label="Set directions to default" vartype="bool">False</SetDirections>
	</Attributes>
	<LinePlot>
		<title label="Title" vartype="str"></title>
		<xlabel label="x-axis label" vartype="str"></xlabel>
		<ylabel label="y-axis label" vartype="str"></ylabel>
		<yscale label="y-axis scale" vartype="lstr">linear|log</yscale>
		<frame label="Frame" vartype="bool">True</frame>
		<taxis label="Top axis" vartype="bool">False</taxis>
		<raxis label="Right axis" vartype="bool">False</raxis>
		<baxis label="Bottom axis" vartype="bool">True</baxis>
		<laxis label="Left axis" vartype="bool">True</laxis>
		<grid label="Grid" vartype="bool">True</grid>
		<glinestyle label="Grid line style" vartype="lstr">-- dashed| none|- solid|-. dashdot|: dotted</glinestyle>
		<glinewidth label="Grid line width" vartype="int">1</glinewidth>
		<gcolor label="Grid color" vartype="color">0.6784313725490196 0.6784313725490196 0.6784313725490196</gcolor>
		<color label="Background color" vartype="color">1.0 1.0 1.0</color>
		<linestyle label="Line style" vartype="lstr">- solid| none|-- dashed|-. dashdot|: dotted</linestyle>
		<linewidth label="Line width" vartype="int">2</linewidth>
		<marker label="Marker style" vartype="lstr">o circle| none|. point|, pixel|g octagon|s square|p pentagon|P plus filled|* star|h hexagon1|H hexagon2|+ plus|x cross|X cross filled|D diamond|d thin diamond</marker>
		<markersize label="Maker size" vartype="int">10</markersize>
	</LinePlot>
	<BarPlot>
