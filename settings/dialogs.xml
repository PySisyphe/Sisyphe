		<linestyle label="Line style" vartype="lstr"> none|- solid|-- dashed|-. dashdot|: dotted</linestyle>
		<linewidth label="Line width" vartype="int">1</linewidth>
		<barwidth label="Bar width" varmin="0.1" varmax="1.0" vartype="float">0.8</barwidth>
